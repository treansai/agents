APP_ENV=development
APP_API_KEY=change-me-at-least-32-characters
APP_LEDGER_HMAC_KEY=change-me-at-least-32-characters
APP_LOG_LEVEL=INFO
APP_DATABASE_PATH=data/agents.db
APP_AGENOMIC_DATA_PATH=data/agenomic
APP_AGENOMIC_RELEASE=agenomic-demo-agents@1.0.0

# Agenomic Cloud (mode connecté — laisser vide pour rester local/offline)
# L'API d'ingestion est api.agenomic.io (app.agenomic.io est la console web).
APP_AGENOMIC_ENDPOINT=
APP_AGENOMIC_API_KEY=
APP_AGENOMIC_AGENT_UUID=
APP_AGENOMIC_TRACKING_SESSION=
APP_AGENOMIC_ENVIRONMENT=production
APP_AGENOMIC_BASELINE_MODEL_ID=gemini-2.5-flash
APP_CLAIMS_HIGH_VALUE_AMOUNT=50000

# Models
APP_ADK_MODEL=gemini-2.5-flash
APP_CREW_MODEL=openai/gpt-5-mini
APP_LANGGRAPH_MODEL=openai:gpt-5-mini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Langfuse (EU cloud by default; self-hosted URLs are supported)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_OTEL_ENABLED=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agenomic-demo-agents

# Privacy: never capture prompts in production unless explicitly approved.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
