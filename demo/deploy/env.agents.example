# Bloc à AJOUTER à /opt/agenomic/.env sur le serveur (valeurs à remplir).
# Générer les secrets : python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Domaine public de l'agent (DNS à créer, voir DEPLOIEMENT-PROD.md étape 2)
AGENTS_DOMAIN=agents.agenomic.io

# Image (registre Scaleway, jamais de build local dans le bundle)
AGENTS_IMAGE_TAG=v1.0.0

# Secrets applicatifs (>= 32 caractères, refusés sinon au démarrage en production)
AGENTS_APP_API_KEY=
AGENTS_LEDGER_HMAC_KEY=

# Connexion Agenomic Cloud (org de démo créée via ETAPES.md section B)
AGENTS_AGENOMIC_API_KEY=
AGENTS_AGENOMIC_AGENT_UUID=
AGENTS_AGENOMIC_RELEASE=claims-reviewer@v1.0.0

# LLM — GOOGLE_API_KEY requis pour les endpoints HTTP (pipeline ADK) ;
# laisser vide si la démo passe par le CLI --no-llm dans le conteneur.
AGENTS_GOOGLE_API_KEY=
AGENTS_OPENAI_API_KEY=
